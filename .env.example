# demo runs without API keys. live uses real providers and never mixes demo places.
APP_MODE=demo
DATABASE_URL=sqlite:///./data/city-life.db
API_BASE_URL=http://127.0.0.1:8000

AMAP_API_KEY=
BOCHA_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
# DeepSeek alternative: LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
REQUEST_TIMEOUT=45

